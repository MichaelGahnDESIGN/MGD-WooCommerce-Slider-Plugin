{
  "meta": {
    "name": "MGD Super-Slider Optionen",
    "schema": 1,
    "hinweis": "Eine Quelle für Standardwerte und Grenzen. Die PHP-Klasse Config und die JS-Datei mgd-slider-model.js halten sich daran (Test prüft das)."
  },
  "limits": { "free_sliders": 5 },
  "defaults": {
    "mode": "classic",
    "label": "",
    "autoplay": false,
    "interval": 5000,
    "speed": 400,
    "pauseOnHover": true,
    "arrows": true,
    "dots": true,
    "swipe": true,
    "loop": true,
    "aspect": "16/9",
    "heightPx": 0,
    "fit": "cover",
    "align": "left",
    "accent": "",
    "prime": {
      "source": "random",
      "count": 5,
      "categories": [],
      "products": [],
      "buttonLabel": "Ansehen"
    }
  },
  "ranges": {
    "interval": [2000, 20000],
    "speed": [0, 2000],
    "heightPx": [0, 1200],
    "primeCount": [1, 12],
    "slides": [0, 30]
  },
  "choices": {
    "mode": ["classic", "prime"],
    "source": ["random", "bestseller", "category", "manual"],
    "aspect": ["21/9", "16/9", "3/2", "4/3", "1/1", "3/1"],
    "fit": ["cover", "contain"],
    "align": ["left", "center", "right"]
  }
}
